{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Droidwart": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "Adb": {
    "ServerHost": "adb-server",
    "ServerPort": 5037,
    "CommandTimeout": "00:00:30"
  },
  "Mqtt": {
    "Host": "",
    "Port": 1883,
    "Username": "droidwart-mqtt",
    "Password": "",
    "ClientId": "droidwart",
    "BaseTopic": "droidwart",
    "DiscoveryPrefix": "homeassistant"
  },
  "GitHub": {
    "ApiBaseUrl": "https://api.github.com/",
    "Token": ""
  },
  "Schedule": {
    "InventoryInterval": "06:00:00",
    "ConnectionCheckInterval": "00:01:00"
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Devices": [
    {
      "Id": "android-ip-cam-garden",
      "Name": "IP Cam Garden",
      "Host": "192.168.178.164",
      "Port": 5555,
      "Canary": true
    },
    {
      "Id": "android-ip-cam-garage",
      "Name": "IP Cam Garage",
      "Host": "192.168.178.160",
      "Port": 5555
    }
  ],
  "Apps": [
    {
      "Id": "magisk",
      "Name": "Magisk",
      "Repo": "topjohnwu/Magisk",
      "Variants": [
        {
          "Package": "com.topjohnwu.magisk",
          "AssetPattern": "^Magisk-v[\\d.]+\\.apk$"
        }
      ],
      "Policy": "Notify",
      "NotInstalledHint": "Is the Magisk app hidden? Then add its randomized package name to PackageOverrides on the device."
    },
    {
      "Id": "acca",
      "Name": "AccA",
      "Repo": "mattecarra/acca",
      "Variants": [
        {
          "Package": "mattecarra.accapp",
          "AssetPattern": "^app-release\\.apk$"
        }
      ],
      "Policy": "Manual"
    },
    {
      "Id": "ha-companion",
      "Name": "Home Assistant Companion",
      "Repo": "home-assistant/android",
      "Variants": [
        {
          "Package": "io.homeassistant.companion.android",
          "AssetPattern": "^app-full-release\\.apk$"
        },
        {
          "Package": "io.homeassistant.companion.android.minimal",
          "AssetPattern": "^app-minimal-release\\.apk$"
        }
      ],
      "Policy": "Auto"
    },
    {
      "Id": "obtainium",
      "Name": "Obtainium",
      "Repo": "ImranR98/Obtainium",
      "Variants": [
        {
          "Package": "dev.imranr.obtainium",
          "AssetPattern": "^app-{abi}-release\\.apk$"
        },
        {
          "Package": "dev.imranr.obtainium.fdroid",
          "AssetPattern": "^app-{abi}-fdroid-release\\.apk$"
        }
      ],
      "Policy": "Auto"
    },
    {
      "Id": "termux",
      "Name": "Termux",
      "Repo": "termux/termux-app",
      "Variants": [
        {
          "Package": "com.termux",
          "AssetPattern": "^termux-app_v[\\d.]+\\+github-debug_{abi}\\.apk$"
        }
      ],
      "Policy": "Manual",
      "RequireInstallSource": "github"
    },
    {
      "Id": "ip-camera",
      "Name": "Android IP Camera",
      "Repo": "DigitallyRefined/android-ip-camera",
      "Variants": [
        {
          "Package": "com.github.digitallyrefined.androidipcamera",
          "AssetPattern": "^androidipcamera-[\\d.]+-{abi}-release\\.apk$"
        }
      ],
      "Policy": "Auto",
      "GrantPermissions": true
    }
  ]
}
