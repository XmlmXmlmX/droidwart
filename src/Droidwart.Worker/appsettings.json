{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Droidwart": "Information"
    }
  },
  "Adb": {
    "ServerHost": "adb-server",
    "ServerPort": 5037,
    "CommandTimeout": "00:00:30"
  },
  "Schedule": {
    "InventoryInterval": "06:00:00"
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Devices": [
    {
      "Id": "android-ip-cam-garden",
      "Name": "IP Cam Garten",
      "Host": "192.168.178.164",
      "Port": 5555,
      "Canary": true
    },
    {
      "Id": "android-ip-cam-garage",
      "Name": "IP Cam Garage",
      "Host": "192.168.178.160",
      "Port": 5555
    }
  ],
  "Apps": [
    {
      "Id": "magisk",
      "Name": "Magisk",
      "Repo": "topjohnwu/Magisk",
      "Package": "com.topjohnwu.magisk",
      "AssetPattern": "^Magisk-v.*\\.apk$",
      "Policy": "Notify",
      "NotInstalledHint": "Ist die Magisk-App versteckt? Dann den zufälligen Paketnamen per PackageOverrides beim Gerät eintragen."
    },
    {
      "Id": "acca",
      "Name": "AccA",
      "Repo": "mattecarra/acca",
      "Package": "mattecarra.accapp",
      "AssetPattern": "\\.apk$",
      "Policy": "Manual"
    },
    {
      "Id": "ha-companion",
      "Name": "Home Assistant Companion",
      "Repo": "home-assistant/android",
      "Package": "io.homeassistant.companion.android",
      "AlternativePackages": [ "io.homeassistant.companion.android.minimal" ],
      "AssetPattern": "full.*\\.apk$",
      "Policy": "Auto"
    },
    {
      "Id": "obtainium",
      "Name": "Obtainium",
      "Repo": "ImranR98/Obtainium",
      "Package": "dev.imranr.obtainium",
      "AlternativePackages": [ "dev.imranr.obtainium.fdroid" ],
      "AssetPattern": "^(?!.*fdroid).*{abi}.*\\.apk$",
      "Policy": "Auto"
    },
    {
      "Id": "termux",
      "Name": "Termux",
      "Repo": "termux/termux-app",
      "Package": "com.termux",
      "AssetPattern": "github.*{abi}.*\\.apk$",
      "Policy": "Manual",
      "RequireInstallSource": "github"
    },
    {
      "Id": "ip-camera",
      "Name": "Android IP Camera",
      "Repo": "DigitallyRefined/android-ip-camera",
      "Package": null,
      "AssetPattern": "\\.apk$",
      "Policy": "Auto"
    }
  ]
}
